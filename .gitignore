# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
dist-pilot
# The installable copy for a phone (npm run build:web, tools/web/pwa.mjs)
dist-web

# Rust build output of the native crates (their wasm is committed as generated .ts modules)
native/*/target

# Rust build output of the Crimson Noir OS workspace
crimson_noir_os/target

# Python bytecode of the verification and self-heal scripts
__pycache__/

# Model files (GGUF): the in-page model keeps the operator's in the browser's own storage, and the tiny test model
# (tools/browser/tinyGguf.mjs) is written to a run's temporary folder. Never committed (src/09_Cognition/modelStore.test.ts
# checks that no tracked file starts with the GGUF magic).
*.gguf

# A developer's local AI tooling (assistant settings, permission lists, chat histories, MCP configs): never committed,
# never in an image or the sandbox (tools/selfheal/sandbox.mjs AI_TOOLING; src/zeroTrust.test.ts checks the lists)
.claude/
.cursor/
.continue/
.codeium/
.windsurf/
.aider.conf.yml
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v3
.mcp.json
CLAUDE.local.md

# Tauri build output of the desktop app (src-tauri/.gitignore keeps its own)
src-tauri/target

# Nix: `nix build`'s result links (into the store, dangling once it is collected) and direnv's cache of the dev shell.
# Tailwind scans what git does not ignore, so an unignored result link would change the page npm builds (the Nix build
# takes git's files alone: tools/nix/page.nix).
result
result-*
.direnv/
