{
  "name": "civic-simulation",
  "private": true,
  "version": "1.3.0",
  "description": "A civic city simulation in one self-contained WebGPU page: GPU pedestrians, Rapier3D traffic and a Three Laws safety kernel.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pilot": "tsc -b && vite build --mode pilot",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@dimforge/rapier3d-simd-compat": "^0.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
